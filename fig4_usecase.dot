digraph G { rankdir=LR; nodesep=0.18; ranksep=1.3; graph [fontname="Liberation Serif", pad=0.15, bgcolor=white]; node [fontname="Liberation Serif", fontsize=12, style="filled,rounded", shape=box, fillcolor="#E8EEF5", color="#1F3A5F", penwidth=1.3]; edge [fontname="Liberation Serif", fontsize=10, color="#1F3A5F", penwidth=1.2];

node [fontsize=11];
an [label="Claims\nAnalyst", shape=box, style=filled, fillcolor=white]; fm [label="Finance\nManager", shape=box, style=filled, fillcolor=white];
