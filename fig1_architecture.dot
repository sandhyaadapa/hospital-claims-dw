digraph G { rankdir=TB; nodesep=0.3; ranksep=0.5; newrank=true; graph [fontname="Liberation Serif", pad=0.15, bgcolor=white]; node [fontname="Liberation Serif", fontsize=12, style="filled,rounded", shape=box, fillcolor="#E8EEF5", color="#1F3A5F", penwidth=1.3]; edge [fontname="Liberation Serif", fontsize=10, color="#1F3A5F", penwidth=1.2];

subgraph cluster_src { label="SOURCE SYSTEMS"; fontsize=12; style="rounded,dashed"; color="#F4F4F4"; fontcolor="#1F3A5F";
  s1 [label="Hospital billing /\nHIS claim tables"]; s2 [label="Insurer adjudication\nfeed (status, payments)"]; s3 [label="Patient registration\nand master data"]; }
subgraph cluster_etl { label="STAGING AND ETL (Python)"; fontsize=12; style="rounded,dashed"; color="#F4F4F4"; fontcolor="#1F3A5F";
  e1 [label="1. Incremental\nextract", fillcolor="#FBE9D8", color="#C8691E"]; e2 [label="2. Data-quality\ngate (R1-R6)", fillcolor="#FBE9D8", color="#C8691E"];
  e3 [label="3. Transform:\nSCD, surrogate keys", fillcolor="#FBE9D8", color="#C8691E"]; e4 [label="4. Load and\nupsert facts", fillcolor="#FBE9D8", color="#C8691E"]; rej [label="DQ reject log\nand ETL audit", shape=cylinder, fillcolor="white"]; }
subgraph cluster_dw { label="DATA WAREHOUSE (SQLite)"; fontsize=12; style="rounded,dashed"; color="#F4F4F4"; fontcolor="#1F3A5F";
  d1 [label="9 conformed\ndimensions", fillcolor="#D7EEEC", color="#1B7F79"]; d2 [label="fact_claim_line\n(transaction grain)", fillcolor="#D7EEEC", color="#1B7F79"]; d3 [label="monthly snapshot\nfact (aggregate)", fillcolor="#D7EEEC", color="#1B7F79"]; }
subgraph cluster_bi { label="ANALYTICS"; fontsize=12; style="rounded,dashed"; color="#F4F4F4"; fontcolor="#1F3A5F";
  a1 [label="OLAP SQL queries\n(roll-up, drill-down,\nslice, dice)"]; a2 [label="Dashboard and\nreports"]; }
u [label="Claims manager\nFinance / Analyst", shape=oval, fillcolor="white"];
{rank=same; s1; s2; s3} {rank=same; e1; e2; e3; e4} {rank=same; d1; d2; d3} {rank=same; a1; a2}
s1 -> e1; s2 -> e1; s3 -> e1; e1 -> e2 -> e3 -> e4 [constraint=false]; e1 -> e2 [constraint=false]; e2 -> rej [style=dashed]; e3 -> d1; e4 -> d2; d2 -> d3 [constraint=false]; d1 -> d2 [constraint=false, style=dotted, dir=none]; d2 -> a1; d3 -> a1; a1 -> a2 [constraint=false]; a2 -> u; a1 -> u [style=invis];
}